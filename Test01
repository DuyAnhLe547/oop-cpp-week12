#include <iostream>
#include <string>
using namespace std;

//1. Define the Fish class 
class Fish{
private:
    int id;
    string name;
    string color;
    string characteristic;
//2. Implement Constructors
public:
    Fish(){
        id = 0;
        name = "";
        color = "";
        characteristic = "";
    }

    Fish(int ID){
        id = ID;
        name = "";
        color = "";
        characteristic = "";
    }

    Fish(int ID, string Name){
        id = ID;
        name = Name;
        color = "";
        characteristic = "";
    }

    Fish(int ID, string Name, string Color){
        id = ID;
        name = Name;
        color = Color;
        characteristic = "";
    }

    Fish(int ID, string Name, string Color, string charac){
        id = ID;
        name = Name;
        color = Color;
        characteristic = charac;
    }

    //3. Implement Getter and Setter Methods
    int getId(){
        return id;
    }

    string getName(){
        return name;
    }

    string getColor(){
        return color;
    }

    string getCharac(){
        return characteristic;
    }

    void setId(int i) {
        id = i;
    }

    void setName(string n) {
        name = n;
    }

    void setColor(string c) {
        color = c;
    }

    void setCharacteristic(string ch) {
        characteristic = ch;
    }

    //4. Implement a Method to Display Fish Information
    void displayFishInfo(){
        cout << "ID: " << id << endl;
        cout << "name: " << name << endl;
        cout << "color: " << color << endl;
        cout << "characteristic: " << characteristic << endl;

    }
};

//5. implement the main function
int main(){
// 1.
    Fish f1;
    Fish f2(2);
    Fish f3(3, "goldfish");
    Fish f4(4, "alpha", "blue");
    Fish f5(5, "Koi", "orange", "active");

// 2.
    f1.displayFishInfo();
    cout << endl;

    f2.displayFishInfo();
    cout << endl;

    f3.displayFishInfo();
    cout << endl;

    f4.displayFishInfo();
    cout << endl;

    f5.displayFishInfo();

// 3.
    f1.setName("Japanese Koi");
    f1.setColor("Red and white");
    f1.setCharacteristic("Swims actively");

// 4.
    cout << "ID: " << f1.getId() << endl;
    cout << "Name: " << f1.getName() << endl;
    cout << "Color: " << f1.getColor() << endl;
    cout << "Characteristic: " << f1.getCharac() << endl;

// 5.
    f5.displayFishInfo();


    return 0;

}









